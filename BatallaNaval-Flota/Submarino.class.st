"
Representa un barco sumergible dentro de la flota y tiene un tamaño de 3 casilleros, también gestiona su estado de inmersión
"
Class {
	#name : 'Submarino',
	#superclass : 'Nave',
	#category : 'BatallaNaval-Flota',
	#package : 'BatallaNaval-Flota'
}

{ #category : 'accessing' }
Submarino >> tamano [ ^ 3
]
