"
Clase para la imagen del fondo de la interfaz
"
Class {
	#name : 'RecursoFondo',
	#superclass : 'Object',
	#category : 'BatallaNaval-Grafica',
	#package : 'BatallaNaval-Grafica'
}

{ #category : 'recursos' }
RecursoFondo class >> datos [ ^ ''
]

{ #category : 'accessing' }
RecursoFondo class >> formularioDelFondo [
    ^ [ PNGReadWriter formFromStream: (ZnBase64Encoder new decode: self datos) readStream ]
        on: Error
        do: [ :error | nil ]

]
